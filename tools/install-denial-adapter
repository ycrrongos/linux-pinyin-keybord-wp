#!/usr/bin/env python3
"""Apply the tested pinned Denial OSK adapter; no host/phone runtime is restarted."""
from pathlib import Path
import sys,shutil,json
root=Path(__file__).resolve().parents[1];host=Path(sys.argv[1]).resolve();pending={}
for relative,before,after in json.loads((root/'integration/denial/host-patches.json').read_text()):
 p=host/relative;s=pending.get(p,p.read_text())
 if after in s:continue
 if s.count(before)!=1:raise SystemExit('Unexpected/partial pinned host: '+relative+'; no patch files written')
 pending[p]=s.replace(before,after,1)
osk=host/'lib/src/widgets/osk';state=host/'lib/src/state'
if not osk.is_dir() or not state.is_dir():raise SystemExit('Invalid Denial plugin')
for name in ['pinyin_engine.dart','pinyin_session.dart','keyboard_tools.dart']:shutil.copy2(root/'lib/src'/name,osk/name)
for name in ['pinyin_keyboard.dart','keyboard_tools_panel.dart']:shutil.copy2(root/'integration/denial'/name,osk/name)
shutil.copy2(root/'integration/denial/wp_motion.dart',state/'win10x_wp_motion.dart')
for p,s in pending.items():p.write_text(s)
print('Adapter/chord bridge/space drag installed. Add package assets, matching patched native broker and host WP theme before runtime acceptance.')
